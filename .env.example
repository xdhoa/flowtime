# Server-only. Never put real secrets into GitHub or public/.
# Local: copy this file to .env (app.py loads it). Hosting: set the same names as environment variables.
# Leave the three Supabase values unset to run demo-only mode.
# Every account that signs up (and confirms its email) becomes a manager with its own request link.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
APP_URL=http://localhost:3000
# Choose a Responses API model that supports Structured Outputs in your account.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Total AI calls per day across ALL managers (protects your OpenAI bill with open sign-up).
AI_DAILY_LIMIT=300
# Optional deadline digest and explicit handoff email
RESEND_API_KEY=
EMAIL_FROM=Flowtime <notifications@your-verified-domain.com>
CRON_SECRET=REPLACE_WITH_RANDOM_AT_LEAST_32_CHARACTERS
PORT=3000
